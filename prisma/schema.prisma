generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                                                       Int                          @id @default(autoincrement())
  name                                                                     String
  email                                                                    String                       @unique
  roleId                                                                   Int
  createdAt                                                                DateTime                     @default(now())
  updatedAt                                                                DateTime                     @updatedAt
  passwordHash                                                             String?
  berita_acara                                                             berita_acara[]
  delegasi_wewenang                                                        delegasi_wewenang[]
  kunjungan_checkpoint                                                     kunjungan_checkpoint[]
  laporan_harian_operasional_laporan_harian_operasional_approved_byTousers laporan_harian_operasional[] @relation("laporan_harian_operasional_approved_byTousers")
  laporan_harian_operasional_laporan_harian_operasional_dibuat_olehTousers laporan_harian_operasional[] @relation("laporan_harian_operasional_dibuat_olehTousers")
  officer                                                                  Officer?
  patroli_tugas                                                            patroli_tugas[]
  shiftswaprequests                                                        shiftswaprequests[]
  roleRef                                                                  Role                         @relation(fields: [roleId], references: [id])

  @@map("users")
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  level           Int
  rolePermissions RolePermission[]
  users           User[]

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  code        String           @unique
  name        String
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Officer {
  id                                                       Int                       @id @default(autoincrement())
  userId                                                   Int                       @unique
  nama                                                     String
  facePhotoUrl                                             String?
  faceEnrolledAt                                           DateTime?
  createdAt                                                DateTime                  @default(now())
  updatedAt                                                DateTime                  @updatedAt
  nik                                                      String                    @unique @db.VarChar(50)
  jabatan                                                  String                    @db.VarChar(100)
  lokasiTugas                                              String                    @db.VarChar(150)
  telepon                                                  String?                   @db.VarChar(30)
  email                                                    String?                   @db.VarChar(255)
  status                                                   String                    @default("aktif") @db.VarChar(20)
  tanggalMasuk                                             DateTime?                 @db.Timestamptz(6)
  catatan                                                  String?
  supervisorId                                             Int?
  regu_id                                                  BigInt?
  jenis_seragam                                            jenis_seragam?            @default(PDL)
  tanggal_mulai_rotasi_override                            DateTime?                 @db.Date
  assignments                                              Assignment[]
  attendances                                              Attendance[]
  cek_perlengkapan                                         cek_perlengkapan[]
  cutibalance                                              CutiBalance[]
  cutirequests_cutirequests_approvedbyToofficers           CutiRequest[]             @relation("cutirequests_approvedbyToofficers")
  cutirequests_cutirequests_officeridToofficers            CutiRequest[]             @relation("cutirequests_officeridToofficers")
  delegasi_wewenang_delegasi_wewenang_danru_idToofficers   delegasi_wewenang[]       @relation("delegasi_wewenang_danru_idToofficers")
  delegasi_wewenang_delegasi_wewenang_wadanru_idToofficers delegasi_wewenang[]       @relation("delegasi_wewenang_wadanru_idToofficers")
  laporan_harian                                           laporan_harian[]
  laporan_harian_personil                                  laporan_harian_personil[]
  regu                                                     regu?                     @relation(fields: [regu_id], references: [id], onUpdate: NoAction)
  officers_officers_supervisorIdToofficers                 Officer?                  @relation("officers_supervisorIdToofficers", fields: [supervisorId], references: [id])
  other_officers_officers_supervisorIdToofficers           Officer[]                 @relation("officers_supervisorIdToofficers")
  user                                                     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  patroli_tugas                                            patroli_tugas[]
  rekap_gaji                                               rekap_gaji[]
  shiftassignments                                         shiftassignments[]

  @@index([supervisorId])
  @@map("officers")
}

model Assignment {
  id                      Int                       @id @default(autoincrement())
  officerId               Int
  tanggal                 DateTime
  shiftNama               String?
  jamMulai                String?
  jamSelesai              String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime?                 @updatedAt
  siteId                  Int?
  catatan                 String?
  shiftId                 Int?
  officer                 Officer                   @relation(fields: [officerId], references: [id], onDelete: Cascade)
  shifts                  Shift?                    @relation(fields: [shiftId], references: [id], map: "assignments_shiftid_fkey")
  sites                   sites?                    @relation(fields: [siteId], references: [id], map: "assignments_siteid_fkey")
  attendance              Attendance?
  laporan_harian_personil laporan_harian_personil[]

  @@unique([officerId, tanggal])
  @@map("assignments")
}

model Attendance {
  id                 Int        @id @default(autoincrement())
  officerId          Int
  assignmentId       Int        @unique
  tanggal            DateTime
  waktuMasuk         DateTime?
  waktuKeluar        DateTime?
  latMasuk           Float?
  lngMasuk           Float?
  latKeluar          Float?
  lngKeluar          Float?
  fotoMasukUrl       String?
  fotoKeluarUrl      String?
  isLate             Boolean    @default(false)
  keterlambatanMenit Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  assignment         Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  officer            Officer    @relation(fields: [officerId], references: [id], onDelete: Cascade)

  @@unique([officerId, tanggal])
  @@map("attendances")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model sites {
  id                         Int                          @id @default(autoincrement())
  name                       String                       @db.VarChar(150)
  latitude                   Decimal                      @db.Decimal(10, 7)
  longitude                  Decimal                      @db.Decimal(10, 7)
  radius_meters              Int                          @default(100)
  is_active                  Boolean                      @default(true)
  created_at                 DateTime                     @default(now())
  updated_at                 DateTime                     @default(now())
  assignments                Assignment[]
  berita_acara               berita_acara[]
  checkpoint_patroli         checkpoint_patroli[]
  geofences                  GeoFence[]
  laporan_harian             laporan_harian[]
  laporan_harian_operasional laporan_harian_operasional[]
  patroli_tugas              patroli_tugas[]
  rute_patroli               rute_patroli[]
  shiftassignments           shiftassignments[]

  @@map("sites")
}

model GeoFence {
  id           Int      @id @default(autoincrement())
  siteId       Int      @map("site_id")
  name         String
  latitude     Float
  longitude    Float
  radiusMeters Int      @default(100) @map("radius_meters")
  description  String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  site         sites    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("geofences")
}

model Jabatan {
  id                                                    BigInt         @id @default(autoincrement())
  kode                                                  String         @unique @db.VarChar(50)
  nama                                                  String         @unique @db.VarChar(150)
  aktif                                                 Boolean        @default(true)
  createdAt                                             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                             DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  berita_acara_berita_acara_atasan_jabatan_idTojabatan  berita_acara[] @relation("berita_acara_atasan_jabatan_idTojabatan")
  berita_acara_berita_acara_ketahui_jabatan_idTojabatan berita_acara[] @relation("berita_acara_ketahui_jabatan_idTojabatan")
  berita_acara_berita_acara_petugas_jabatan_idTojabatan berita_acara[] @relation("berita_acara_petugas_jabatan_idTojabatan")

  @@map("jabatan")
}

model LokasiGedung {
  id           BigInt         @id @default(autoincrement())
  kode         String         @unique @db.VarChar(50)
  nama         String         @unique @db.VarChar(150)
  aktif        Boolean        @default(true)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  berita_acara berita_acara[]

  @@map("lokasi_gedung")
}

model Shift {
  id                         Int                          @id @default(autoincrement())
  nama                       String                       @unique @db.VarChar(100)
  jamMulai                   String                       @map("jam_mulai") @db.VarChar(5)
  jamSelesai                 String                       @map("jam_selesai") @db.VarChar(5)
  aktif                      Boolean                      @default(true)
  createdAt                  DateTime                     @default(now()) @map("created_at")
  updatedAt                  DateTime                     @default(now()) @updatedAt @map("updated_at")
  warnaTema                  String?                      @default("#3B82F6") @map("warna_tema") @db.VarChar(20)
  keterangan                 String?
  kode                       String?                      @unique @db.VarChar(5)
  assignments                Assignment[]
  laporan_harian_operasional laporan_harian_operasional[]
  patroli_tugas              patroli_tugas[]
  pola_rotasi                pola_rotasi[]
  shiftassignments           shiftassignments[]

  @@map("shifts")
}

model CutiBalance {
  id         Int      @id @default(autoincrement())
  officerid  Int
  tahun      Int      @default(dbgenerated("EXTRACT(year FROM CURRENT_DATE)"))
  jatahtotal Int      @default(12)
  terpakai   Int      @default(0)
  createdat  DateTime @default(now()) @db.Timestamp(6)
  updatedat  DateTime @default(now()) @db.Timestamp(6)
  officers   Officer  @relation(fields: [officerid], references: [id], onDelete: Cascade)

  @@unique([officerid, tahun], map: "cutibalance_officer_tahun_unique")
  @@map("cutibalance")
}

model CutiRequest {
  id                                         Int       @id @default(autoincrement())
  officerid                                  Int
  jenis                                      String    @default("cuti") @db.VarChar(20)
  status                                     String    @default("pending") @db.VarChar(20)
  tanggalmulai                               DateTime  @db.Date
  tanggalselesai                             DateTime  @db.Date
  alasan                                     String
  catatan                                    String?
  suratsakiturl                              String?
  approvedby                                 Int?
  approvedat                                 DateTime? @db.Timestamp(6)
  createdat                                  DateTime  @default(now()) @db.Timestamp(6)
  updatedat                                  DateTime  @default(now()) @db.Timestamp(6)
  officers_cutirequests_approvedbyToofficers Officer?  @relation("cutirequests_approvedbyToofficers", fields: [approvedby], references: [id])
  officers_cutirequests_officeridToofficers  Officer   @relation("cutirequests_officeridToofficers", fields: [officerid], references: [id], onDelete: Cascade)

  @@index([officerid])
  @@index([status])
  @@index([tanggalmulai, tanggalselesai], map: "cutirequests_tanggal_idx")
  @@map("cutirequests")
}

model shiftassignments {
  id                                                                          Int                 @id @default(autoincrement())
  officerid                                                                   Int
  shiftid                                                                     Int
  tanggal                                                                     DateTime            @db.Date
  createdat                                                                   DateTime            @default(now()) @db.Timestamp(6)
  updatedat                                                                   DateTime?           @default(now()) @db.Timestamp(6)
  siteid                                                                      Int?
  cek_perlengkapan                                                            cek_perlengkapan?
  officers                                                                    Officer             @relation(fields: [officerid], references: [id], onDelete: Cascade, map: "shiftassignments_officer_fk")
  shifts                                                                      Shift               @relation(fields: [shiftid], references: [id], map: "shiftassignments_shift_fk")
  sites                                                                       sites?              @relation(fields: [siteid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "shiftassignments_site_fk")
  shiftswaprequests_shiftswaprequests_requesterassignmentidToshiftassignments shiftswaprequests[] @relation("shiftswaprequests_requesterassignmentidToshiftassignments")
  shiftswaprequests_shiftswaprequests_targetassignmentidToshiftassignments    shiftswaprequests[] @relation("shiftswaprequests_targetassignmentidToshiftassignments")

  @@unique([officerid, tanggal], map: "shiftassignments_officer_tanggal_key")
  @@unique([officerid, tanggal], map: "unique_officer_tanggal")
  @@index([officerid, tanggal], map: "idx_shiftassignments_officer_tanggal")
  @@index([officerid], map: "idx_shiftassignments_officerid")
  @@index([shiftid], map: "idx_shiftassignments_shiftid")
  @@index([tanggal], map: "idx_shiftassignments_tanggal")
  @@index([siteid], map: "idx_shiftassignments_siteid")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model shiftswaprequests {
  id                                                                         Int              @id @default(autoincrement())
  requesterassignmentid                                                      Int
