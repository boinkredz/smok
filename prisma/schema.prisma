  @@unique([requesterassignmentid, targetassignmentid], map: "uq_shiftswaprequests_pending", where: raw("((status)::text = 'pending'::text)"))
  @@index([createdat(sort: Desc)], map: "idx_shiftswaprequests_createdat")
  @@index([requesterassignmentid], map: "idx_shiftswaprequests_requesterassignmentid")
  @@index([status], map: "idx_shiftswaprequests_status")
  @@index([targetassignmentid], map: "idx_shiftswaprequests_targetassignmentid")
