  jabatan_berita_acara_ketahui_jabatan_idTojabatan Jabatan?     @relation("berita_acara_ketahui_jabatan_idTojabatan", fields: [ketahui_jabatan_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_berita_acara_ketahui_jabatan")
  lokasi_gedung                                    LokasiGedung @relation(fields: [lokasi_gedung_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_berita_acara_lokasi_gedung")
  jabatan_berita_acara_petugas_jabatan_idTojabatan Jabatan      @relation("berita_acara_petugas_jabatan_idTojabatan", fields: [petugas_jabatan_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_berita_acara_petugas_jabatan")
