  approvedby                                                                 Int?
  approvedat                                                                 DateTime?        @db.Timestamp(6)
  createdat                                                                  DateTime         @default(now()) @db.Timestamp(6)
  updatedat                                                                  DateTime         @default(now()) @db.Timestamp(6)
  users                                                                      User?            @relation(fields: [approvedby], references: [id], onUpdate: NoAction, map: "shiftswaprequests_approvedby_fk")
  shiftassignments_shiftswaprequests_requesterassignmentidToshiftassignments shiftassignments @relation("shiftswaprequests_requesterassignmentidToshiftassignments", fields: [requesterassignmentid], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "shiftswaprequests_requester_assignment_fk")
